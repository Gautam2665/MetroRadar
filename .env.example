# Backend Configuration
PORT=3001

# Database Configuration
# In docker-compose, postgres hostname is used. For local development outside docker, use localhost.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/metroradar?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Map Style Configuration
MAP_STYLE_URL="https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json"

# GTFS-Realtime Configuration (Delhi OTD)
# Get your key at https://otd.delhi.gov.in
OTD_API_KEY="your_otd_api_key_here"
OTD_BASE_URL="https://otd.delhi.gov.in/api/realtime"
REALTIME_POLL_INTERVAL_SECONDS=30

